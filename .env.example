# Kopieren nach .env.local und ausfüllen. .env.local wird nicht eingecheckt.
# Client-ID und Client-Geheimnis deiner Zoom-App im Marketplace,
# in der unter „Funktionen → Einbetten“ das Meeting SDK eingeschaltet ist.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Optional: anderer Port als 4300
# PORT=4300
