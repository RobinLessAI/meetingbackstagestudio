# Kopieren nach .env.local und ausfüllen. .env.local wird nicht eingecheckt.
# Werte aus deiner Zoom-App im Marketplace (General App, vom Nutzer verwaltet):
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Empfohlen: Ereignisse per WebSocket (kein Tunnel nötig).
# Die Subscription ID steht in der wss-Adresse deines Event-Abonnements
# (…?subscriptionId=XYZ). Die komplette Adresse funktioniert auch.
ZOOM_WS_SUBSCRIPTION_ID=

# Für „Chat-Datenstrom starten“ per Meeting-Link: dieselbe Adresse wie
# „OAuth Weiterleitungs-URL“ in der Zoom-App.
ZOOM_REDIRECT_URI=

# Nur für die Webhook-Variante mit Tunnel: Secret Token der Zoom-App.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Optional: anderer Port als 4300
# PORT=4300
